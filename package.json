{
  "name": "ggorgxyz",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.22.3 || ^24.16.0 || >=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:js": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.{css,astro,html}\" --allow-empty-input --max-warnings=0",
    "lint:fix": "pnpm run lint:js --fix && pnpm run lint:css --fix",
