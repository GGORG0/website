---
import Title from "./Title.astro";
import Personal from "./Personal.astro";
import Links from "./Links.astro";
---

<main class="container shadow">
  <div class="mainbox">
    <Title />
    <Personal />
    <Links />
    <footer>
      <ul>
        <li>This website contains no JavaScript.</li>
        <li>
          <a href="https://astro.build">Made with Astro.</a>
        </li>
        <li>
          <a href="https://github.com/GGORG0/website">
            Open source under the GPL.
          </a>
        </li>
      </ul>
    </footer>
  </div>
</main>

<style>
  .container {
    width: auto;
    height: auto;
    position: relative;
    padding: 1.5em;
    background-color: var(--ctp-surface0);

    --shadow-color: var(--ctp-sapphire);
  }

  @media (orientation: portrait) {
    .container {
      width: 100%;
      background-color: #0000;

      --shadow-color: #0000;
    }
  }

  .mainbox {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }

  /* stylelint-disable selector-pseudo-class-no-unknown */
  .mainbox :global(ul) {
    list-style-type: none;
    padding-left: 0;
    margin: 0;
    line-height: 1.4;
  }

  footer {
    color: var(--ctp-subtext0);
    font-size: 0.9rem;
  }
</style>
