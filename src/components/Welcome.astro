<style>
  .container {
    width: auto;
    height: auto;
    position: relative;
    padding: 1.5em;
    background-color: var(--ctp-surface0);

    --shadow-color: var(--ctp-sapphire);
  }

  @media (orientation: portrait) {
    .container {
      width: 100%;
      background-color: #0000;

      --shadow-color: #0000;
    }
  }

  .mainbox {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
  }

  ul {
    list-style-type: none;
    padding-left: 0;
    margin: 0;
    line-height: 1.4;
  }

  a {
    color: inherit;
  }

  footer {
    color: var(--ctp-subtext0);
    font-size: 0.9rem;
  }
</style>
