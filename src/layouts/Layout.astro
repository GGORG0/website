---
import { Font } from "astro:assets";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,user-scalable=0"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-recursive" preload />
    <Font cssVariable="--font-emoji" />
    <title>GGORG</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html {
    font-size: 100%;
  }

  :root {
    font-family: var(--font-recursive);
    font-weight: 400;

    --border-radius: 5px;
  }

  body {
    background-color: var(--ctp-base);
    color: var(--ctp-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
  }
</style>
